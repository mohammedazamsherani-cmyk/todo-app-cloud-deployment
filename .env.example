# ========================================
# Environment Configuration Template
# Copy to .env and update values
# ========================================

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
NODE_VERSION=22.21.0-alpine3.21

# ========================================
# Port Configuration
# ========================================
APP_PORT=3000
VITE_PORT=5173
DEBUG_PORT=9230
PROD_PORT=8080

# ========================================
# Database Configuration
# ========================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=todoapp
POSTGRES_USER=todoapp
POSTGRES_PASSWORD=todoapp_password
DB_PORT=5432

# ========================================
# Security Configuration
# ========================================
ALLOWED_ORIGINS=https://yourdomain.com

# ========================================
# Google Cloud Deployment (placeholders)
# On Cloud Run these are set by Terraform; POSTGRES_HOST is the Cloud SQL
# unix socket dir, e.g. /cloudsql/<PROJECT_ID>:<REGION>:todoapp-pg
# ========================================
GCP_PROJECT_ID=<PROJECT_ID>
GCP_REGION=europe-west1
ARTIFACT_REGISTRY_REPO=todoapp
CLOUD_RUN_SERVICE=todoapp
